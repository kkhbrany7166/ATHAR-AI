# Copy to backend/.env. Never commit real keys.
# LLM provider: anthropic | openai | none. Leave empty to auto-detect from whichever key is set.
ATHAR_LLM_PROVIDER=
ANTHROPIC_API_KEY=
ATHAR_ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
ATHAR_OPENAI_MODEL=gpt-4.1-mini
# Signing secret for demo session tokens. Change it outside local development.
ATHAR_SECRET=change-me-local-dev-only
ATHAR_DATABASE_URL=sqlite:///./data/athar.db
